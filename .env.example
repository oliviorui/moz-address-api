NODE_ENV=development

HOST=0.0.0.0
PORT=3333

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moz_address?schema=public"

# "*" allows browser requests from any origin.
# To restrict access, use a comma-separated list:
# CORS_ORIGIN="https://example.com,https://app.example.com"
CORS_ORIGIN="*"

# Set this when the API runs behind a reverse proxy, otherwise all clients
# share one rate limit. Use a comma-separated list of proxy IPs/CIDRs. If the
# proxy IPs change, as on most hosting platforms, use the number of proxies
# (usually 1), but only if clients cannot reach the API directly.
# Avoid "true": clients can forge X-Forwarded-For and bypass the rate limit.
TRUST_PROXY="false"

# Maximum requests per IP during RATE_LIMIT_WINDOW.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW="1 minute"

# How long clients may reuse a successful API response.
CACHE_MAX_AGE_SECONDS=3600

NODE_ENV=development

HOST=0.0.0.0
PORT=3333

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moz_address?schema=public"

# "*" allows browser requests from any origin.
# To restrict access, use a comma-separated list:
# CORS_ORIGIN="https://example.com,https://app.example.com"
CORS_ORIGIN="*"

# Set this when the API runs behind a reverse proxy, otherwise all clients
# share one rate limit. Use a comma-separated list of proxy IPs/CIDRs.
# "true" trusts any X-Forwarded-For value, so use it only when clients cannot
# reach the API directly; otherwise they can bypass the rate limit.
TRUST_PROXY="false"

# Maximum requests per IP during RATE_LIMIT_WINDOW.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW="1 minute"

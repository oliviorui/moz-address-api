{
  "name": "moz-address-api",
  "version": "0.1.0",
  "description": "Open-source REST API and dataset for Mozambique's administrative divisions.",
  "keywords": [
    "mozambique",
    "address",
    "api",
    "provinces",
    "districts",
    "administrative-posts",
    "localities",
    "open-data"
  ],
  "license": "MIT",
  "author": "Olívio Rui Cumbe",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/api.smoke.test.ts",
    "test:integration": "tsx --test tests/api.integration.test.ts",
    "test:all": "npm run test && npm run test:integration",
    "data:validate": "tsx scripts/validate-data.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
